<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_kpis_tree_weighted_discount" model="ir.ui.view">
        <field name="name">purchase.order.kpis.list.weighted.discount</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="free_customizations_enabled" column_invisible="1"/>
                <field name="weighted_discount" optional="show" invisible="not free_customizations_enabled"/>
                <field name="vendor_last_discount" optional="show" invisible="not free_customizations_enabled"/>
            </field>
        </field>
    </record>

    <record id="purchase_order_view_tree_weighted_discount" model="ir.ui.view">
        <field name="name">purchase.order.list.weighted.discount</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="free_customizations_enabled" column_invisible="1"/>
                <field name="weighted_discount" optional="show" invisible="not free_customizations_enabled"/>
                <field name="vendor_last_discount" optional="show" invisible="not free_customizations_enabled"/>
            </field>
        </field>
    </record>

    <record id="purchase_order_line_compare_tree_optional_fields" model="ir.ui.view">
        <field name="name">purchase.order.line.compare.list.optional.fields</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase_requisition.purchase_order_line_compare_tree"/>
        <field name="arch" type="xml">
            <field name="product_qty" position="after">
                <field name="free_customizations_enabled" column_invisible="1"/>
                <field name="reorder_min_qty" optional="show" invisible="not free_customizations_enabled"/>
            </field>
            <field name="price_unit" position="after">
                <field name="vendor_last_discount" optional="show" invisible="not free_customizations_enabled"/>
                <field name="weighted_discount" optional="show" invisible="not free_customizations_enabled"/>
            </field>
        </field>
    </record>
</odoo>
