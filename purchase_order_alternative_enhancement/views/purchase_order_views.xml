<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_discount_history" model="ir.ui.view">
        <field name="name">purchase.order.form.discount.history</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="free_customizations_enabled" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='discount']" position="after">
                <field name="weighted_discount" optional="show" column_invisible="not parent.free_customizations_enabled" invisible="display_type"/>
                <field name="vendor_last_discount" optional="show" column_invisible="not parent.free_customizations_enabled" invisible="display_type"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='discount']" position="after">
                <field name="weighted_discount" invisible="not parent.free_customizations_enabled"/>
                <field name="vendor_last_discount" invisible="not parent.free_customizations_enabled"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_tree_discount_history" model="ir.ui.view">
        <field name="name">purchase.order.base.list.discount.history</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="weighted_discount" optional="show"/>
                <field name="vendor_last_discount" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
