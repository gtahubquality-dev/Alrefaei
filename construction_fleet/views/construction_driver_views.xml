<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_driver_form" model="ir.ui.view">
        <field name="name">construction.driver.form</field>
        <field name="model">construction.driver</field>
        <field name="arch" type="xml">
            <form string="Driver">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="alert alert-danger mb-2" role="alert" invisible="not license_expired">
                        The driving license of this driver has expired.
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Driver full name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="employee_id" options="{'no_create': True}"/>
                            <field name="id_number"/>
                            <field name="mobile" widget="phone"/>
                            <field name="employment_status"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Driving License">
                            <field name="license_number"/>
                            <field name="license_type"/>
                            <field name="license_expiry"/>
                            <field name="license_expired" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Documents" name="documents">
                            <field name="document_ids">
                                <list editable="bottom">
                                    <field name="document_type"/>
                                    <field name="name"/>
                                    <field name="number"/>
                                    <field name="issue_date" optional="hide"/>
                                    <field name="expiry_date"/>
                                    <field name="attachment" filename="attachment_name" widget="binary"/>
                                    <field name="attachment_name" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Assigned Vehicles" name="vehicles">
                            <field name="vehicle_ids" readonly="1">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="license_plate"/>
                                    <field name="current_project_id"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_construction_driver_list" model="ir.ui.view">
        <field name="name">construction.driver.list</field>
        <field name="model">construction.driver</field>
        <field name="arch" type="xml">
            <list string="Drivers" decoration-danger="license_expired">
                <field name="name"/>
                <field name="license_number"/>
                <field name="license_expiry"/>
                <field name="id_number"/>
                <field name="mobile"/>
                <field name="vehicle_ids" widget="many2many_tags" optional="show"/>
                <field name="document_count" optional="show"/>
                <field name="license_expired" column_invisible="True"/>
                <field name="employment_status" widget="badge" decoration-success="employment_status == 'active'" decoration-danger="employment_status == 'terminated'"/>
            </list>
        </field>
    </record>
    <record id="view_construction_driver_search" model="ir.ui.view">
        <field name="name">construction.driver.search</field>
        <field name="model">construction.driver</field>
        <field name="arch" type="xml">
            <search string="Search Drivers">
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('license_number', 'ilike', self), ('id_number', 'ilike', self)]"/>
                <field name="mobile"/>
                <filter string="Active" name="status_active" domain="[('employment_status', '=', 'active')]"/>
                <filter string="License Expired" name="license_expired" domain="[('license_expiry', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Employment Status" name="group_status" context="{'group_by': 'employment_status'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_construction_driver" model="ir.actions.act_window">
        <field name="name">Drivers</field>
        <field name="res_model">construction.driver</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your drivers</p>
            <p>Keep each driver's license, identity, mobile, employment status and document copies, and assign a driver to every vehicle.</p>
        </field>
    </record>
</odoo>
