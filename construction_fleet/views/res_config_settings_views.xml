<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_construction_fleet" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.construction.fleet</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="construction_equipment.res_config_settings_view_form_construction_equipment"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='construction_equipment_setting_container']" position="after">
                <block title="Fleet" name="construction_fleet_setting_container">
                    <setting id="construction_transport_expense_account" string="Vehicle Transport Cost" company_dependent="1" help="Expense account of trips settled through the driver custody sheets (falls back on the equipment maintenance / rental expense account).">
                        <field name="construction_transport_expense_account_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
