<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_fleet_vehicles" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">construction.equipment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_vehicle', '=', True)]</field>
        <field name="context">{'default_category': 'truck_light'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register the vehicles of the fleet</p>
            <p>Heavy and light transport, trailers, sweepers, tractors, dump trucks and private cars, with plate,
                chassis number, color, ownership (owned / rented) and their assigned driver.</p>
        </field>
    </record>
</odoo>
