<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_transport_type_list" model="ir.ui.view">
        <field name="name">construction.transport.type.list</field>
        <field name="model">construction.transport.type</field>
        <field name="arch" type="xml">
            <list string="Trip Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="uom_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_construction_transport_type" model="ir.actions.act_window">
        <field name="name">Trip Types</field>
        <field name="res_model">construction.transport.type</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
