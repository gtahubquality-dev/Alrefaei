<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_product_form_view_product_code" model="ir.ui.view">
        <field name="name">product.product.form.product.code</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="free_customizations_enabled" invisible="1"/>
                <field name="product_code" invisible="not free_customizations_enabled"/>
            </field>
        </field>
    </record>
</odoo>
