<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_custody_request_company" model="ir.rule">
        <field name="name">Custody: multi-company</field>
        <field name="model_id" ref="model_custody_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_custody_request_own" model="ir.rule">
        <field name="name">Custody: own custodies</field>
        <field name="model_id" ref="model_custody_request"/>
        <field name="domain_force">['|', ('requested_by_id', '=', user.id), ('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_custody_user'))]"/>
    </record>
    <record id="rule_custody_request_all" model="ir.rule">
        <field name="name">Custody: all custodies</field>
        <field name="model_id" ref="model_custody_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_custody_manager'))]"/>
    </record>
    <record id="rule_custody_settlement_company" model="ir.rule">
        <field name="name">Custody settlement: multi-company</field>
        <field name="model_id" ref="model_custody_settlement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_custody_settlement_own" model="ir.rule">
        <field name="name">Custody settlement: own custodies</field>
        <field name="model_id" ref="model_custody_settlement"/>
        <field name="domain_force">['|', ('custody_id.requested_by_id', '=', user.id), ('custody_id.employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_custody_user'))]"/>
    </record>
    <record id="rule_custody_settlement_all" model="ir.rule">
        <field name="name">Custody settlement: all</field>
        <field name="model_id" ref="model_custody_settlement"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_custody_manager'))]"/>
    </record>
    <record id="rule_custody_settlement_line_company" model="ir.rule">
        <field name="name">custody.settlement.line: multi-company</field>
        <field name="model_id" ref="model_custody_settlement_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_custody_settlement_return_company" model="ir.rule">
        <field name="name">custody.settlement.return: multi-company</field>
        <field name="model_id" ref="model_custody_settlement_return"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_custody_settlement_line_own" model="ir.rule">
        <field name="name">custody.settlement.line: own custodies</field>
        <field name="model_id" ref="model_custody_settlement_line"/>
        <field name="domain_force">['|', ('settlement_id.custody_id.requested_by_id', '=', user.id), ('settlement_id.custody_id.employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_custody_user'))]"/>
    </record>
    <record id="rule_custody_settlement_line_all" model="ir.rule">
        <field name="name">custody.settlement.line: all</field>
        <field name="model_id" ref="model_custody_settlement_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_custody_manager'))]"/>
    </record>
    <record id="rule_custody_settlement_return_own" model="ir.rule">
        <field name="name">custody.settlement.return: own custodies</field>
        <field name="model_id" ref="model_custody_settlement_return"/>
        <field name="domain_force">['|', ('settlement_id.custody_id.requested_by_id', '=', user.id), ('settlement_id.custody_id.employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_custody_user'))]"/>
    </record>
    <record id="rule_custody_settlement_return_all" model="ir.rule">
        <field name="name">custody.settlement.return: all</field>
        <field name="model_id" ref="model_custody_settlement_return"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_custody_manager'))]"/>
    </record>
</odoo>
