<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_custody" model="ir.module.category">
        <field name="name">Financial Custody</field>
        <field name="sequence">45</field>
    </record>
    <record id="res_groups_privilege_custody" model="res.groups.privilege">
        <field name="name">Financial Custody</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_custody"/>
    </record>
    <record id="group_custody_user" model="res.groups">
        <field name="name">Employee</field>
        <field name="comment">Requests custodies and submits their settlements.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_custody"/>
    </record>
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_custody_user'))]"/>
    </record>
    <record id="group_custody_manager" model="res.groups">
        <field name="name">Custody Manager</field>
        <field name="comment">Reviews custody requests, confirms disbursement and validates settlements.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_custody"/>
        <field name="implied_ids" eval="[(4, ref('group_custody_user')), (4, ref('account.group_account_invoice')), (4, ref('stock.group_stock_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
