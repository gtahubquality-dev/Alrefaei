<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_custody_request" model="ir.sequence">
        <field name="name">Financial Custody</field>
        <field name="code">custody.request</field>
        <field name="prefix">CUS/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_custody_settlement" model="ir.sequence">
        <field name="name">Custody Settlement</field>
        <field name="code">custody.settlement</field>
        <field name="prefix">CST/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
