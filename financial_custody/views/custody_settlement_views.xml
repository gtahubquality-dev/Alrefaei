<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custody_settlement_form" model="ir.ui.view">
        <field name="name">custody.settlement.form</field>
        <field name="model">custody.settlement</field>
        <field name="arch" type="xml">
            <form string="Custody Settlement">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_post" type="object" string="Validate &amp; Post" class="btn-primary" invisible="state != 'submitted'" groups="financial_custody.group_custody_manager"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state not in ('submitted', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('posted', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_move" type="object" class="oe_stat_button" icon="fa-book" string="Journal Entry" invisible="state != 'posted'" groups="financial_custody.group_custody_manager"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="custody_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="employee_id"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="custody_amount"/>
                            <field name="custody_balance"/>
                            <field name="submitted_by_id" invisible="not submitted_by_id"/>
                            <field name="posted_by_id" invisible="not posted_by_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Expenses" name="expenses">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="vendor_id" optional="show"/>
                                    <field name="invoice_ref"/>
                                    <field name="invoice_date" optional="hide"/>
                                    <field name="attachment" filename="attachment_name" widget="binary"/>
                                    <field name="attachment_name" column_invisible="True"/>
                                    <field name="account_id" optional="show" groups="financial_custody.group_custody_manager"/>
                                    <field name="analytic_distribution" widget="analytic_distribution" optional="show" groups="analytic.group_analytic_accounting"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="amount" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_expenses"/>
                                <field name="cash_returned" readonly="state != 'draft'"/>
                                <field name="total_settled" class="oe_subtotal_footer_separator"/>
                            </group>
                            <group invisible="cash_returned &lt;= 0" groups="financial_custody.group_custody_manager">
                                <field name="cash_journal_id" readonly="state == 'posted'"/>
                            </group>
                        </page>
                        <page string="Returned Items" name="returns">
                            <field name="return_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="company_id" column_invisible="True"/>
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="warehouse_id"/>
                                </list>
                            </field>
                            <field name="picking_ids" readonly="1" groups="stock.group_stock_user" invisible="not picking_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="location_dest_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_custody_settlement_list" model="ir.ui.view">
        <field name="name">custody.settlement.list</field>
        <field name="model">custody.settlement</field>
        <field name="arch" type="xml">
            <list string="Custody Settlements">
                <field name="name"/>
                <field name="custody_id"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="total_expenses" sum="Expenses"/>
                <field name="cash_returned" sum="Cash"/>
                <field name="total_settled" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-warning="state == 'submitted'"/>
            </list>
        </field>
    </record>
    <record id="view_custody_settlement_search" model="ir.ui.view">
        <field name="name">custody.settlement.search</field>
        <field name="model">custody.settlement</field>
        <field name="arch" type="xml">
            <search string="Search Settlements">
                <field name="name"/>
                <field name="custody_id"/>
                <field name="employee_id"/>
                <filter string="Waiting Review" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Posted" name="posted" domain="[('state', '=', 'posted')]"/>
                <group>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Custody" name="group_custody" context="{'group_by': 'custody_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_custody_settlement" model="ir.actions.act_window">
        <field name="name">Settlements</field>
        <field name="res_model">custody.settlement</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
