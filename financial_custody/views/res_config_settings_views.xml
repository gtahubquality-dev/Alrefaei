<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_custody" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.custody</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Financial Custody" string="Financial Custody" name="financial_custody" groups="financial_custody.group_custody_manager">
                    <block title="Accounting" name="custody_accounting_setting_container">
                        <setting id="custody_account" string="Custody Account" company_dependent="1" help="Account holding the cash advanced to employees until settlement.">
                            <field name="custody_account_id"/>
                        </setting>
                        <setting id="custody_journal" string="Disbursement Journal" company_dependent="1" help="Default bank or cash journal used to pay custodies.">
                            <field name="custody_journal_id"/>
                        </setting>
                        <setting id="custody_settlement_journal" string="Settlement Journal" company_dependent="1" help="Miscellaneous journal of settlement entries.">
                            <field name="custody_settlement_journal_id"/>
                        </setting>
                    </block>
                    <block title="Rules" name="custody_rules_setting_container">
                        <setting id="custody_threshold" string="Minimum Settlement Before New Custody" company_dependent="1" help="Percentage of the previous custody that must be settled before a new request.">
                            <field name="custody_settlement_threshold"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="action_custody_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'financial_custody', 'bin_size': False}</field>
    </record>
</odoo>
