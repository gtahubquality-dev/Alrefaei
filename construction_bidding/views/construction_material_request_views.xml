<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_material_request_list" model="ir.ui.view">
        <field name="name">construction.material.request.list</field>
        <field name="model">construction.material.request</field>
        <field name="arch" type="xml">
            <list create="0"><field name="project_id"/><field name="boq_id"/></list>
        </field>
    </record>
    <record id="view_construction_material_request_form" model="ir.ui.view">
        <field name="name">construction.material.request.form</field>
        <field name="model">construction.material.request</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group><field name="project_id"/><field name="boq_id"/></group>
                    <notebook>
                        <page string="Material Lines">
                            <field name="line_ids">
                                <list>
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="uom_id"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_construction_material_request" model="ir.actions.act_window">
        <field name="name">Material Requests</field>
        <field name="res_model">construction.material.request</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_construction_material_request" name="Material Requests" parent="menu_construction_bidding_root" action="action_construction_material_request" sequence="20"/>
</odoo>
