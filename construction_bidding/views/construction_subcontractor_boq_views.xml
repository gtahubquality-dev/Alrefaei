<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_subcontractor_boq_list" model="ir.ui.view">
        <field name="name">construction.subcontractor.boq.list</field>
        <field name="model">construction.subcontractor.boq</field>
        <field name="arch" type="xml">
            <list create="0"><field name="project_id"/><field name="boq_id"/></list>
        </field>
    </record>
    <record id="view_construction_subcontractor_boq_form" model="ir.ui.view">
        <field name="name">construction.subcontractor.boq.form</field>
        <field name="model">construction.subcontractor.boq</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header><button name="action_create_contract" string="Create Contract" type="object" class="btn-primary"/></header>
                <sheet>
                    <group><field name="project_id"/><field name="boq_id"/></group>
                    <notebook>
                        <page string="Distribution Lines">
                            <field name="line_ids">
                                <list>
                                    <field name="product_id"/>
                                    <field name="finished_product_id"/>
                                    <field name="description"/>
                                    <field name="uom_id"/>
                                    <field name="quantity"/>
                                    <field name="distributed_quantity"/>
                                    <field name="available_quantity"/>
                                </list>
                            </field>
                        </page>
                        <page string="Contracts">
                            <field name="contract_ids"><list><field name="partner_id"/><field name="project_id"/></list></field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_construction_subcontractor_boq" model="ir.actions.act_window">
        <field name="name">Subcontractors</field>
        <field name="res_model">construction.subcontractor.boq</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_construction_subcontractor_boq" name="Subcontractors" parent="menu_construction_bidding_root" action="action_construction_subcontractor_boq" sequence="40"/>
</odoo>
