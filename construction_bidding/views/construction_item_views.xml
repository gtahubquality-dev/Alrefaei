<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_item_list" model="ir.ui.view">
        <field name="name">construction.item.list</field>
        <field name="model">construction.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id" domain="[('type', '=', 'service')]"/>
                <field name="quantity"/>
            </list>
        </field>
    </record>
    <record id="view_construction_item_form" model="ir.ui.view">
        <field name="name">construction.item.form</field>
        <field name="model">construction.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="product_id" domain="[('type', '=', 'service')]"/>
                        <field name="quantity"/>
                    </group>
                    <notebook>
                        <page name="material" string="Materials / Components">
                            <field name="material_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="cost"/>
                                </list>
                            </field>
                        </page>
                        <page name="subcontractor" string="Subcontractor">
                            <field name="subcontractor_line_ids">
                                <list editable="bottom">
                                    <field name="product_id" domain="[('type', '=', 'service')]"/>
                                    <field name="quantity"/>
                                    <field name="finished_product_id" domain="[('type', '=', 'service')]"/>
                                </list>
                            </field>
                        </page>
                        <page name="equipment" string="Equipment">
                            <field name="equipment_line_ids">
                                <list editable="bottom">
                                    <field name="product_id" domain="[('is_equipment', '=', True)]"/>
                                    <field name="quantity"/>
                                    <field name="cost"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_construction_item" model="ir.actions.act_window">
        <field name="name">Items</field>
        <field name="res_model">construction.item</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_construction_items" name="Items" parent="menu_bidding_configuration" action="action_construction_item" sequence="5"/>
</odoo>
