<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_boq_list" model="ir.ui.view">
        <field name="name">construction.boq.list</field>
        <field name="model">construction.boq</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="total_cost" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_construction_boq_form" model="ir.ui.view">
        <field name="name">construction.boq.form</field>
        <field name="model">construction.boq</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm BOQ" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_view_variation_orders" type="object" icon="fa-exchange">
                            <field name="variation_order_count" widget="statinfo" string="VOs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="partner_id"/>
                            <field name="planned_date"/>
                            <field name="user_id"/>
                            <field name="contract_id"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_cost"/>
                            <field name="adjustment_type"/>
                            <field name="margin"/>
                            <field name="final_insurance"/>
                            <field name="retention_percentage"/>
                            <field name="advance_payment"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="main_items" string="Main Items">
                            <field name="main_line_ids" context="{'default_item_type': 'main'}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="item_type" column_invisible="1"/>
                                    <field name="item_id"/>
                                    <field name="planned_quantity"/>
                                    <button name="action_set_quantity" string="Set Quantity" type="object"/>
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="unit_cost"/>
                                    <field name="total_cost"/>
                                    <field name="weight_percentage"/>
                                    <field name="cost_percentage"/>
                                </list>
                            </field>
                        </page>
                        <page name="materials" string="Materials">
                            <field name="material_line_ids" context="{'default_item_type': 'material'}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="item_type" column_invisible="1"/>
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="unit_cost"/>
                                    <field name="total_cost"/>
                                    <field name="weight_percentage"/>
                                    <field name="cost_percentage"/>
                                </list>
                            </field>
                        </page>
                        <page name="equipment" string="Equipment">
                            <field name="equipment_line_ids" context="{'default_item_type': 'equipment'}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="item_type" column_invisible="1"/>
                                    <field name="product_id" domain="[('is_equipment', '=', True)]"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="unit_cost"/>
                                    <field name="total_cost"/>
                                    <field name="weight_percentage"/>
                                    <field name="cost_percentage"/>
                                </list>
                            </field>
                        </page>
                        <page name="subcontractors" string="Subcontractors">
                            <field name="subcontractor_line_ids" context="{'default_item_type': 'subcontractor'}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="item_type" column_invisible="1"/>
                                    <field name="product_id" domain="[('type', '=', 'service')]"/>
                                    <field name="finished_product_id" domain="[('type', '=', 'service')]"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="unit_cost"/>
                                    <field name="total_cost"/>
                                    <field name="weight_percentage"/>
                                    <field name="cost_percentage"/>
                                </list>
                            </field>
                        </page>
                        <page name="deductions" string="Deductions">
                            <field name="deduction_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="product_uom_id"/>
                                    <field name="price_unit"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_boq_search" model="ir.ui.view">
        <field name="name">construction.boq.search</field>
        <field name="model">construction.boq</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_construction_boq" model="ir.actions.act_window">
        <field name="name">BOQs</field>
        <field name="res_model">construction.boq</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bidding_boq" name="BOQs" parent="menu_boq_variation_root" action="action_construction_boq" sequence="10"/>
</odoo>
