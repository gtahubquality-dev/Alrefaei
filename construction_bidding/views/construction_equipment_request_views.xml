<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_equipment_request_list" model="ir.ui.view">
        <field name="name">construction.equipment.request.list</field>
        <field name="model">construction.equipment.request</field>
        <field name="arch" type="xml">
            <list create="0"><field name="project_id"/><field name="boq_id"/></list>
        </field>
    </record>
    <record id="view_construction_equipment_request_form" model="ir.ui.view">
        <field name="name">construction.equipment.request.form</field>
        <field name="model">construction.equipment.request</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group><field name="project_id"/><field name="boq_id"/></group>
                    <notebook>
                        <page string="Equipment Lines">
                            <field name="line_ids">
                                <list>
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="uom_id"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_construction_equipment_request" model="ir.actions.act_window">
        <field name="name">Equipment Requests</field>
        <field name="res_model">construction.equipment.request</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_construction_equipment_request" name="Equipment Requests" parent="menu_construction_bidding_root" action="action_construction_equipment_request" sequence="30"/>
</odoo>
