<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_warehouse_wizard_form" model="ir.ui.view">
        <field name="name">construction.project.warehouse.wizard.form</field>
        <field name="model">construction.project.warehouse.wizard</field>
        <field name="arch" type="xml">
            <form string="Project Warehouse">
                <group>
                    <field name="project_id"/>
                    <field name="short_name"/>
                    <field name="create_boq" invisible="1"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
