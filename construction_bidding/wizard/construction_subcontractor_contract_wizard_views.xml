<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_subcontractor_contract_wizard" model="ir.ui.view">
        <field name="name">construction.subcontractor.contract.wizard.form</field>
        <field name="model">construction.subcontractor.contract.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Subcontractor Contract">
                <group><field name="subcontractor_boq_id" readonly="1"/><field name="partner_id"/></group>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="source_line_id" readonly="1"/>
                        <field name="product_id"/>
                        <field name="available_quantity"/>
                        <field name="quantity"/>
                    </list>
                </field>
                <footer>
                    <button name="action_create_contract" string="Create Contract" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
