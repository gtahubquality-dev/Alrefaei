<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_bidding_tender_company" model="ir.rule">
        <field name="name">Tender: multi-company</field>
        <field name="model_id" ref="model_bidding_tender"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bidding_boq_item_company" model="ir.rule">
        <field name="name">Bidding BOQ item: multi-company</field>
        <field name="model_id" ref="model_bidding_boq_item"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bidding_boq_component_company" model="ir.rule">
        <field name="name">Bidding BOQ component: multi-company</field>
        <field name="model_id" ref="model_bidding_boq_component"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
