<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_sales_weighted_discount" model="ir.ui.view">
        <field name="name">product.template.form.sales.weighted.discount</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='taxes_div']" position="after">
                <field name="free_customizations_enabled" invisible="1"/>
                <label for="sales_discount" invisible="not free_customizations_enabled or type == 'combo' or product_variant_count &gt; 1"/>
                <div class="o_row" invisible="not free_customizations_enabled or type == 'combo' or product_variant_count &gt; 1">
                    <field name="sales_discount" class="oe_inline"/>
                    <span>%</span>
                </div>
                <label for="weighted_discount" invisible="not free_customizations_enabled or type == 'combo' or product_variant_count &gt; 1"/>
                <div class="o_row" invisible="not free_customizations_enabled or type == 'combo' or product_variant_count &gt; 1">
                    <field name="weighted_discount" class="oe_inline"/>
                    <span>%</span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
