<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="deduction_type_withholding" model="construction.deduction.type">
            <field name="name">Withholding Tax</field>
            <field name="sequence">10</field>
            <field name="kind">tax</field>
            <field name="calculation">percent</field>
            <field name="value">5.0</field>
            <field name="refundable" eval="False"/>
            <field name="company_id" eval="False"/>
        </record>
        <record id="deduction_type_fees" model="construction.deduction.type">
            <field name="name">Stamp / Government Fees</field>
            <field name="sequence">20</field>
            <field name="kind">fee</field>
            <field name="calculation">percent</field>
            <field name="value">0.0</field>
            <field name="refundable" eval="False"/>
            <field name="company_id" eval="False"/>
        </record>
        <record id="deduction_type_suspense" model="construction.deduction.type">
            <field name="name">Suspense Amount (Taaliyat)</field>
            <field name="sequence">30</field>
            <field name="kind">suspense</field>
            <field name="calculation">percent</field>
            <field name="value">0.0</field>
            <field name="refundable" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>
        <record id="deduction_type_contract_stamp" model="construction.deduction.type">
            <field name="name">Contract Stamp Duty</field>
            <field name="sequence">40</field>
            <field name="kind">fee</field>
            <field name="calculation">fixed</field>
            <field name="frequency">once</field>
            <field name="applies_to">both</field>
            <field name="value">0.0</field>
            <field name="refundable" eval="False"/>
            <field name="company_id" eval="False"/>
        </record>
        <record id="deduction_type_site_services" model="construction.deduction.type">
            <field name="name">Site Services (Water, Electricity)</field>
            <field name="sequence">50</field>
            <field name="kind">other</field>
            <field name="calculation">percent</field>
            <field name="frequency">every</field>
            <field name="applies_to">subcontractor</field>
            <field name="value">0.0</field>
            <field name="refundable" eval="False"/>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
