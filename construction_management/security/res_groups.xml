<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_construction" model="res.groups.privilege">
        <field name="name">Construction Projects</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="construction_bidding.module_category_construction"/>
    </record>
    <record id="res_groups_privilege_construction_finance" model="res.groups.privilege">
        <field name="name">Construction Finance</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="construction_bidding.module_category_construction"/>
    </record>
    <record id="res_groups_privilege_construction_equipment" model="res.groups.privilege">
        <field name="name">Construction Equipment</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="construction_bidding.module_category_construction"/>
    </record>
    <record id="group_construction_user" model="res.groups">
        <field name="name">Site Engineer</field>
        <field name="comment">Works on assigned projects: quantities, material requests, subcontractor requests and site approvals.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_construction"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_construction_manager" model="res.groups">
        <field name="name">Senior Management</field>
        <field name="comment">Full access to all projects, approves change orders, price increases up to 25%, material requests above BOQ and subcontracts.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_construction"/>
        <field name="implied_ids" eval="[(4, ref('group_construction_user')), (4, ref('construction_bidding.group_bidding_user'))]"/>
    </record>
    <record id="group_construction_executive" model="res.groups">
        <field name="name">Executive Management</field>
        <field name="comment">Grants exceptional approvals for price increases above 25%.</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_construction"/>
        <field name="implied_ids" eval="[(4, ref('group_construction_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_construction_finance" model="res.groups">
        <field name="name">Construction Accountant</field>
        <field name="comment">Audits subcontractor invoices, confirms owner invoices, records guarantees, advances, refunds and equipment expenses.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_construction_finance"/>
        <field name="implied_ids" eval="[(4, ref('group_construction_user')), (4, ref('account.group_account_invoice'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_construction_transport" model="res.groups">
        <field name="name">Equipment Transportation Manager</field>
        <field name="comment">Manages equipment register, assignments, movements between sites, rentals and maintenance expenses.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_construction_equipment"/>
        <field name="implied_ids" eval="[(4, ref('group_construction_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
