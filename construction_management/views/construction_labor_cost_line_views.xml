<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_labor_cost_line_list" model="ir.ui.view">
        <field name="name">construction.labor.cost.line.list</field>
        <field name="model">construction.labor.cost.line</field>
        <field name="arch" type="xml">
            <list string="Allocated Labor Costs" create="0" edit="0" delete="0">
                <field name="project_id"/>
                <field name="assignment_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="days" sum="Days"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount" sum="Total"/>
                <field name="move_id"/>
            </list>
        </field>
    </record>
    <record id="action_construction_labor_cost_line" model="ir.actions.act_window">
        <field name="name">Allocated Labor Costs</field>
        <field name="res_model">construction.labor.cost.line</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
