<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_guarantee_form" model="ir.ui.view">
        <field name="name">construction.guarantee.form</field>
        <field name="model">construction.guarantee</field>
        <field name="arch" type="xml">
            <form string="Guarantee">
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state != 'draft'" groups="construction_management.group_construction_finance,construction_management.group_construction_manager"/>
                    <button name="action_open_extend" type="object" string="Extend" invisible="state not in ('active', 'expired')" groups="construction_management.group_construction_finance,construction_management.group_construction_manager"/>
                    <button name="action_release" type="object" string="Release" invisible="state not in ('active', 'expired')" groups="construction_management.group_construction_finance,construction_management.group_construction_manager" confirm="Release this guarantee?"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,released"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger" invisible="state != 'expired'"/>
                    <widget name="web_ribbon" title="Released" bg_color="text-bg-success" invisible="state != 'released'"/>
                    <div class="alert alert-warning mb-2" role="alert" invisible="state != 'active' or days_to_expiry &gt; 30">
                        This guarantee expires in <field name="days_to_expiry" class="oe_inline"/> days.
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Guarantee">
                            <field name="direction" widget="radio" readonly="state != 'draft'"/>
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="subcontract_id" invisible="direction != 'received'" required="direction == 'received'" readonly="state != 'draft'"/>
                            <field name="guarantee_type" readonly="state != 'draft'"/>
                            <field name="guarantee_form" widget="radio" readonly="state != 'draft'"/>
                            <field name="beneficiary_id" readonly="state != 'draft'"/>
                            <field name="applicant_id" readonly="state != 'draft'"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Bank" invisible="guarantee_form != 'bank'">
                            <field name="bank_id" required="guarantee_form == 'bank' and state == 'draft'" readonly="state != 'draft'"/>
                            <field name="reference" required="guarantee_form == 'bank' and state == 'draft'" readonly="state != 'draft'"/>
                            <field name="cash_margin"/>
                            <field name="bank_commission"/>
                        </group>
                        <group string="Cash Payment" invisible="guarantee_form != 'cash' or direction != 'issued' or guarantee_type != 'final'">
                            <field name="journal_id" readonly="state != 'draft'"/>
                            <field name="operation_id" invisible="not operation_id"/>
                        </group>
                        <group string="Amount &amp; Validity">
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="percentage"/>
                            <field name="issue_date" readonly="state != 'draft'"/>
                            <field name="expiry_date" readonly="state != 'draft'" required="guarantee_form == 'bank'"/>
                            <field name="release_date" invisible="not release_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Extensions" name="extensions">
                            <field name="extension_ids" readonly="1">
                                <list>
                                    <field name="create_date" string="Date"/>
                                    <field name="old_expiry_date"/>
                                    <field name="new_expiry_date"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="old_amount"/>
                                    <field name="new_amount"/>
                                    <field name="user_id"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_construction_guarantee_list" model="ir.ui.view">
        <field name="name">construction.guarantee.list</field>
        <field name="model">construction.guarantee</field>
        <field name="arch" type="xml">
            <list string="Guarantees" decoration-danger="state == 'expired' or (state == 'active' and days_to_expiry &lt;= 30)" decoration-muted="state in ('released', 'cancelled')">
                <field name="name"/>
                <field name="project_id"/>
                <field name="subcontract_id" optional="hide"/>
                <field name="direction" optional="show"/>
                <field name="guarantee_type"/>
                <field name="guarantee_form"/>
                <field name="bank_id" optional="show"/>
                <field name="reference" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount" sum="Total"/>
                <field name="issue_date" optional="hide"/>
                <field name="expiry_date"/>
                <field name="days_to_expiry" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-danger="state == 'expired'" decoration-info="state == 'released'"/>
            </list>
        </field>
    </record>
    <record id="view_construction_guarantee_search" model="ir.ui.view">
        <field name="name">construction.guarantee.search</field>
        <field name="model">construction.guarantee</field>
        <field name="arch" type="xml">
            <search string="Search Guarantees">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('reference', 'ilike', self)]"/>
                <field name="project_id"/>
                <field name="subcontract_id"/>
                <field name="bank_id"/>
                <filter string="Active" name="active_guarantees" domain="[('state', '=', 'active')]"/>
                <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
                <filter string="Released" name="released" domain="[('state', '=', 'released')]"/>
                <separator/>
                <filter string="Bank Guarantees" name="bank" domain="[('guarantee_form', '=', 'bank')]"/>
                <filter string="Cash Guarantees" name="cash" domain="[('guarantee_form', '=', 'cash')]"/>
                <separator/>
                <filter string="Issued by Us" name="issued" domain="[('direction', '=', 'issued')]"/>
                <filter string="Received" name="received" domain="[('direction', '=', 'received')]"/>
                <separator/>
                <filter string="Expiry Date" name="filter_expiry" date="expiry_date"/>
                <group>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Bank" name="group_bank" context="{'group_by': 'bank_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'guarantee_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_construction_guarantee" model="ir.actions.act_window">
        <field name="name">Bank &amp; Cash Guarantees</field>
        <field name="res_model">construction.guarantee</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a guarantee</p>
            <p>Track bank letters of guarantee and cash guarantees issued to owners or received from subcontractors, their expiry, extensions and release.</p>
        </field>
    </record>
</odoo>
