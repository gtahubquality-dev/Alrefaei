<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_guarantee_extend_wizard_form" model="ir.ui.view">
        <field name="name">construction.guarantee.extend.wizard.form</field>
        <field name="model">construction.guarantee.extend.wizard</field>
        <field name="arch" type="xml">
            <form string="Extend Guarantee">
                <group>
                    <field name="guarantee_id" readonly="1"/>
                    <field name="current_expiry_date"/>
                    <field name="new_expiry_date"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="new_amount"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_extend" type="object" string="Extend" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
