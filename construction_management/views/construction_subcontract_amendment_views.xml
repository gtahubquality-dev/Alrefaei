<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_subcontract_amendment_form" model="ir.ui.view">
        <field name="name">construction.subcontract.amendment.form</field>
        <field name="model">construction.subcontract.amendment</field>
        <field name="arch" type="xml">
            <form string="Contract Amendment">
                <header>
                    <button name="action_submit" type="object" string="Submit to Management" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'submitted'" groups="construction_management.group_construction_manager"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'submitted'" groups="construction_management.group_construction_manager"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('approved', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state not in ('rejected', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not exceeds_boq">
                        <strong>Exceeds the BOQ - Senior Management approval required</strong>
                        <field name="boq_exceed_note" nolabel="1" class="d-block"/>
                        <field name="exceeds_boq" invisible="1"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="contract_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="project_id"/>
                            <field name="partner_id"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="requested_by_id"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                            <field name="approved_date" invisible="not approved_date"/>
                            <field name="amount_change"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Changes" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="contract_id" column_invisible="True"/>
                                    <field name="project_id" column_invisible="True"/>
                                    <field name="state" column_invisible="True"/>
                                    <field name="change_type"/>
                                    <field name="contract_line_id" invisible="change_type != 'change'" required="change_type == 'change'" options="{'no_create': True}"/>
                                    <field name="boq_item_id" invisible="change_type != 'new'" required="change_type == 'new'" options="{'no_create': True}"/>
                                    <field name="name" optional="show"/>
                                    <field name="current_quantity" optional="show"/>
                                    <field name="quantity_change"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="current_unit_price" optional="show"/>
                                    <field name="new_unit_price"/>
                                    <field name="previous_quantity" optional="hide"/>
                                    <field name="previous_unit_price" optional="hide"/>
                                    <field name="value_change" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reason" name="reason">
                            <field name="reason" readonly="state != 'draft'" placeholder="Reason of the amendment..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_construction_subcontract_amendment_list" model="ir.ui.view">
        <field name="name">construction.subcontract.amendment.list</field>
        <field name="model">construction.subcontract.amendment</field>
        <field name="arch" type="xml">
            <list string="Contract Amendments">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_change" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state == 'submitted'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>
    <record id="view_construction_subcontract_amendment_search" model="ir.ui.view">
        <field name="name">construction.subcontract.amendment.search</field>
        <field name="model">construction.subcontract.amendment</field>
        <field name="arch" type="xml">
            <search string="Search Amendments">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <filter string="Waiting Management" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <group>
                    <filter string="Contract" name="group_contract" context="{'group_by': 'contract_id'}"/>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_construction_subcontract_amendment" model="ir.actions.act_window">
        <field name="name">Contract Amendments</field>
        <field name="res_model">construction.subcontract.amendment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Amend an approved subcontract</p>
            <p>Increase or reduce assigned quantities, change prices or assign new BOQ items to an active subcontract. Senior Management approves the amendment.</p>
        </field>
    </record>
</odoo>
