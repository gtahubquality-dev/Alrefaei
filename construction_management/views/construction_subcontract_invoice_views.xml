<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_subcontract_invoice_form" model="ir.ui.view">
        <field name="name">construction.subcontract.invoice.form</field>
        <field name="model">construction.subcontract.invoice</field>
        <field name="arch" type="xml">
            <form string="Subcontractor Invoice">
                <header>
                    <button name="action_generate_lines" type="object" string="Load Contract Items" class="btn-primary" invisible="state != 'draft' or line_ids"/>
                    <button name="action_compute_deductions" type="object" string="Recompute Deductions" invisible="state != 'draft' or not line_ids"/>
                    <button name="action_site_approve" type="object" string="Approve on Site" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_mgmt_approve" type="object" string="Approve (Senior Management)" class="btn-primary" invisible="state != 'site_approved'" groups="construction_management.group_construction_manager"/>
                    <button name="action_finance_approve" type="object" string="Audit &amp; Create Vendor Bill" class="btn-primary" invisible="state != 'mgmt_approved'" groups="construction_management.group_construction_finance"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state not in ('site_approved', 'mgmt_approved')" groups="construction_management.group_construction_manager,construction_management.group_construction_finance"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state not in ('rejected', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('finance_approved', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,site_approved,mgmt_approved,finance_approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bill" type="object" class="oe_stat_button" icon="fa-pencil-square-o" string="Vendor Bill" invisible="not move_id"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="contract_id" readonly="state != 'draft' or line_ids" force_save="1" options="{'no_create': True}"/>
                            <field name="project_id"/>
                            <field name="partner_id"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date" readonly="state not in ('draft', 'rejected')"/>
                            <field name="vendor_reference" readonly="state not in ('draft', 'rejected')"/>
                            <field name="move_id" invisible="not move_id"/>
                            <field name="payment_state" invisible="not move_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Executed Works" name="lines">
                            <field name="line_ids" readonly="state not in ('draft', 'rejected')">
                                <list editable="bottom" decoration-danger="remaining_quantity &lt; 0">
                                    <field name="contract_id" column_invisible="True"/>
                                    <field name="contract_line_id" options="{'no_create': True}"/>
                                    <field name="uom_id"/>
                                    <field name="contract_quantity"/>
                                    <field name="previous_quantity"/>
                                    <field name="current_quantity"/>
                                    <field name="remaining_quantity"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="unit_price"/>
                                    <field name="amount" sum="Total"/>
                                </list>
                            </field>
                            <group>
                                <group string="Deductions">
                                    <field name="deduction_ids" nolabel="1" colspan="2" readonly="state not in ('draft', 'rejected')">
                                        <list editable="bottom">
                                            <control>
                                                <create string="Add a manual deduction"/>
                                            </control>
                                            <field name="contract_deduction_id" column_invisible="True"/>
                                            <field name="is_manual" column_invisible="True"/>
                                            <field name="name" readonly="not is_manual"/>
                                            <field name="kind" optional="show"/>
                                            <field name="account_id" readonly="not is_manual"/>
                                            <field name="currency_id" column_invisible="True"/>
                                            <field name="amount" sum="Total"/>
                                        </list>
                                    </field>
                                </group>
                                <group class="oe_subtotal_footer">
                                    <field name="gross_amount"/>
                                    <field name="guarantee_amount"/>
                                    <field name="advance_deduction_amount"/>
                                    <field name="deduction_total"/>
                                    <field name="net_amount" class="oe_subtotal_footer_separator"/>
                                </group>
                            </group>
                        </page>
                        <page string="Approval Workflow" name="approvals">
                            <group>
                                <group string="1. Site Engineer">
                                    <field name="site_approved_by_id"/>
                                    <field name="site_approved_date"/>
                                </group>
                                <group string="2. Senior Management">
                                    <field name="mgmt_approved_by_id"/>
                                    <field name="mgmt_approved_date"/>
                                </group>
                                <group string="3. Finance Department">
                                    <field name="finance_approved_by_id"/>
                                    <field name="finance_approved_date"/>
                                </group>
                                <group string="Rejection">
                                    <field name="rejection_reason" nolabel="1" colspan="2" placeholder="Reason for rejection..."/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_construction_subcontract_invoice_list" model="ir.ui.view">
        <field name="name">construction.subcontract.invoice.list</field>
        <field name="model">construction.subcontract.invoice</field>
        <field name="arch" type="xml">
            <list string="Subcontractor Invoices">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="gross_amount" sum="Gross"/>
                <field name="net_amount" sum="Net"/>
                <field name="payment_state" optional="show" widget="badge"/>
                <field name="state" widget="badge" decoration-success="state == 'finance_approved'" decoration-warning="state in ('site_approved', 'mgmt_approved')" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>
    <record id="view_construction_subcontract_invoice_search" model="ir.ui.view">
        <field name="name">construction.subcontract.invoice.search</field>
        <field name="model">construction.subcontract.invoice</field>
        <field name="arch" type="xml">
            <search string="Search Subcontractor Invoices">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Waiting Management" name="site_approved" domain="[('state', '=', 'site_approved')]"/>
                <filter string="Waiting Finance" name="mgmt_approved" domain="[('state', '=', 'mgmt_approved')]"/>
                <filter string="Audited" name="finance_approved" domain="[('state', '=', 'finance_approved')]"/>
                <group>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Subcontractor" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_construction_subcontract_invoice" model="ir.actions.act_window">
        <field name="name">Subcontractor Invoices</field>
        <field name="res_model">construction.subcontract.invoice</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
