<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_construction" model="ir.ui.view">
        <field name="name">account.move.form.construction</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="construction_project_id" readonly="state != 'draft'"/>
                <field name="construction_owner_invoice_id" invisible="not construction_owner_invoice_id"/>
                <field name="construction_subcontract_invoice_id" invisible="not construction_subcontract_invoice_id"/>
            </xpath>
        </field>
    </record>
</odoo>
