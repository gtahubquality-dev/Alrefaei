<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_boq_history_list" model="ir.ui.view">
        <field name="name">construction.boq.history.list</field>
        <field name="model">construction.boq.history</field>
        <field name="arch" type="xml">
            <list string="BOQ Change History" create="0" edit="0" delete="0">
                <field name="change_datetime"/>
                <field name="project_id"/>
                <field name="change_order_id"/>
                <field name="change_type"/>
                <field name="boq_item_id"/>
                <field name="description" optional="hide"/>
                <field name="old_quantity"/>
                <field name="new_quantity"/>
                <field name="quantity_change"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="unit_price"/>
                <field name="value_change" sum="Total"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>
    <record id="view_construction_boq_history_search" model="ir.ui.view">
        <field name="name">construction.boq.history.search</field>
        <field name="model">construction.boq.history</field>
        <field name="arch" type="xml">
            <search string="Search BOQ History">
                <field name="project_id"/>
                <field name="boq_item_id"/>
                <field name="change_order_id"/>
                <field name="user_id"/>
                <filter string="New Items" name="new_items" domain="[('change_type', '=', 'new')]"/>
                <filter string="Quantity Changes" name="quantity_changes" domain="[('change_type', '=', 'quantity')]"/>
                <group>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_construction_boq_history" model="ir.actions.act_window">
        <field name="name">BOQ Change History</field>
        <field name="res_model">construction.boq.history</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
