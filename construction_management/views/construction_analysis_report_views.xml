<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_analysis_report_form" model="ir.ui.view">
        <field name="name">construction.analysis.report.form</field>
        <field name="model">construction.analysis.report</field>
        <field name="arch" type="xml">
            <form string="Construction Report" create="0" delete="0">
                <header>
                    <button name="action_print_pdf" type="object" string="Print PDF" icon="fa-file-pdf-o" class="btn-primary"/>
                    <button name="action_export_xlsx" type="object" string="Export Excel" icon="fa-file-excel-o" class="btn-secondary"/>
                </header>
                <div class="o_form_sheet p-3">
                    <group>
                        <group>
                            <field name="report_type"/>
                            <field name="project_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="All started projects"/>
                        </group>
                        <group invisible="not is_dated">
                            <field name="is_dated" invisible="1"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <field name="report_html" readonly="1" nolabel="1"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_construction_report_overview" model="ir.actions.act_window">
        <field name="name">Projects Overview</field>
        <field name="res_model">construction.analysis.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_construction_analysis_report_form"/>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'overview'}</field>
    </record>
    <record id="action_construction_report_boq" model="ir.actions.act_window">
        <field name="name">BOQ Progress &amp; Cost</field>
        <field name="res_model">construction.analysis.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_construction_analysis_report_form"/>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'boq'}</field>
    </record>
    <record id="action_construction_report_owner_invoices" model="ir.actions.act_window">
        <field name="name">Owner Invoices Analysis</field>
        <field name="res_model">construction.analysis.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_construction_analysis_report_form"/>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'owner_invoices'}</field>
    </record>
    <record id="action_construction_report_subcontracts" model="ir.actions.act_window">
        <field name="name">Subcontractors Report</field>
        <field name="res_model">construction.analysis.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_construction_analysis_report_form"/>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'subcontracts'}</field>
    </record>
    <record id="action_construction_report_materials" model="ir.actions.act_window">
        <field name="name">Material Consumption</field>
        <field name="res_model">construction.analysis.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_construction_analysis_report_form"/>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'materials'}</field>
    </record>
    <record id="action_construction_report_equipment" model="ir.actions.act_window">
        <field name="name">Equipment Operation &amp; Cost</field>
        <field name="res_model">construction.analysis.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_construction_analysis_report_form"/>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'equipment'}</field>
    </record>
    <record id="action_construction_report_guarantees" model="ir.actions.act_window">
        <field name="name">Guarantees &amp; Retention</field>
        <field name="res_model">construction.analysis.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_construction_analysis_report_form"/>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'guarantees'}</field>
    </record>
    <record id="action_construction_report_budget" model="ir.actions.act_window">
        <field name="name">Budget vs Actual by Cost Type</field>
        <field name="res_model">construction.analysis.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_construction_analysis_report_form"/>
        <field name="target">current</field>
        <field name="context">{'default_report_type': 'budget'}</field>
    </record>
</odoo>
