<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_change_order_form" model="ir.ui.view">
        <field name="name">construction.change.order.form</field>
        <field name="model">construction.change.order</field>
        <field name="arch" type="xml">
            <form string="Change Order">
                <header>
                    <button name="action_submit" type="object" string="Submit for Approval" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'submitted'" groups="construction_management.group_construction_manager"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'submitted'" groups="construction_management.group_construction_manager"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('approved', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state not in ('rejected', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="owner_reference" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="requested_by_id"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                            <field name="approved_date" invisible="not approved_date"/>
                            <field name="amount_total"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Changes" name="lines">
                            <field name="line_ids" readonly="state != 'draft'" context="{'default_change_type': 'quantity'}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="change_type"/>
                                    <field name="boq_item_id"/>
                                    <field name="name"/>
                                    <field name="uom_id"/>
                                    <field name="current_quantity" optional="show"/>
                                    <field name="quantity"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="unit_price" optional="show"/>
                                    <field name="value_change" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reason" name="reason">
                            <field name="reason" readonly="state != 'draft'" placeholder="Reason and justification of the change..."/>
                        </page>
                        <page string="History" name="history" invisible="state != 'approved'">
                            <field name="history_ids" readonly="1">
                                <list>
                                    <field name="change_datetime"/>
                                    <field name="change_type"/>
                                    <field name="boq_item_id"/>
                                    <field name="old_quantity"/>
                                    <field name="new_quantity"/>
                                    <field name="user_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_construction_change_order_list" model="ir.ui.view">
        <field name="name">construction.change.order.list</field>
        <field name="model">construction.change.order</field>
        <field name="arch" type="xml">
            <list string="Change Orders">
                <field name="name"/>
                <field name="project_id"/>
                <field name="date"/>
                <field name="owner_reference" optional="show"/>
                <field name="requested_by_id" optional="show"/>
                <field name="approved_by_id" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state == 'submitted'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>
    <record id="view_construction_change_order_search" model="ir.ui.view">
        <field name="name">construction.change.order.search</field>
        <field name="model">construction.change.order</field>
        <field name="arch" type="xml">
            <search string="Search Change Orders">
                <field name="name"/>
                <field name="project_id"/>
                <field name="owner_reference"/>
                <filter string="Waiting Approval" name="to_approve" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <group>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_construction_change_order" model="ir.actions.act_window">
        <field name="name">Change Orders</field>
        <field name="res_model">construction.change.order</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a change order</p>
            <p>Change orders increase quantities of existing BOQ items or add new items. Approved changes update the BOQ and keep a full audit trail.</p>
        </field>
    </record>
</odoo>
