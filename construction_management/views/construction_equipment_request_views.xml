<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_equipment_request_form" model="ir.ui.view">
        <field name="name">construction.equipment.request.form</field>
        <field name="model">construction.equipment.request</field>
        <field name="arch" type="xml">
            <form string="Equipment Request">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'to_approve'" groups="construction_management.group_construction_manager"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'to_approve'" groups="construction_management.group_construction_manager"/>
                    <button name="action_assign" type="object" string="Assign Company Equipment" class="btn-primary" invisible="state != 'submitted'" groups="construction_management.group_construction_transport"/>
                    <button name="action_request_rental" type="object" string="Request External Rental" invisible="state != 'submitted'" groups="construction_management.group_construction_transport"/>
                    <button name="action_unassign" type="object" string="Unassign" invisible="state != 'assigned'" groups="construction_management.group_construction_transport"/>
                    <button name="action_extend_rental" type="object" string="Extend Rental" invisible="state != 'rental'" groups="construction_management.group_construction_transport"/>
                    <button name="action_release" type="object" string="Release" invisible="state not in ('assigned', 'rental')" groups="construction_management.group_construction_transport"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'to_approve', 'submitted')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not exceeds_boq or approved_by_id">
                        <field name="exceeds_boq" invisible="1"/>
                        The request is not covered by the BOQ (no BOQ equipment or quantity above the remaining BOQ
                        quantity): Senior Management approval is required.
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Request">
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="description" readonly="state != 'draft'"/>
                            <field name="date_from" readonly="state not in ('draft', 'submitted')"/>
                            <field name="date_to" readonly="state in ('done', 'cancelled')"/>
                            <field name="expected_hours" readonly="state != 'draft'"/>
                            <field name="requested_by_id"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="BOQ">
                            <field name="boq_component_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="boq_item_id" invisible="not boq_component_id"/>
                            <label for="requested_quantity"/>
                            <div class="o_row">
                                <field name="requested_quantity" readonly="state != 'draft'" class="oe_inline"/>
                                <field name="boq_uom_id" class="oe_inline" invisible="not boq_component_id"/>
                            </div>
                            <field name="boq_quantity" invisible="not boq_component_id"/>
                            <field name="boq_remaining" invisible="not boq_component_id"/>
                        </group>
                        <group string="Consumption &amp; Cost" name="cost">
                            <field name="consumed_quantity" class="fw-bold"/>
                            <field name="unconsumed_quantity" decoration-danger="unconsumed_quantity &lt; 0"/>
                            <field name="planned_cost"/>
                            <field name="actual_cost" class="fw-bold"/>
                            <field name="committed_cost" invisible="not committed_cost"/>
                            <field name="cost_variance" decoration-danger="cost_variance &lt; 0"/>
                            <button name="action_view_cost_lines" type="object" string="Cost Details" icon="fa-list" class="btn-link" colspan="2" invisible="state not in ('assigned', 'rental', 'done')" groups="account.group_account_invoice"/>
                        </group>
                        <group string="Company Equipment">
                            <field name="equipment_id" readonly="state != 'submitted'"/>
                            <field name="source_project_id" invisible="not source_project_id"/>
                        </group>
                        <group string="External Rental">
                            <field name="rental_vendor_id" readonly="state != 'submitted'"/>
                            <field name="rental_product_id" readonly="state != 'submitted'"/>
                            <field name="rental_quantity" readonly="state != 'submitted'"/>
                            <field name="rental_price" readonly="state != 'submitted'"/>
                            <field name="purchase_order_id" invisible="not purchase_order_id"/>
                            <field name="rental_contract_id" invisible="not rental_contract_id"/>
                            <field name="rented_equipment_id" readonly="state not in ('draft', 'submitted')"/>
                            <field name="rental_extension_qty" invisible="state != 'rental'"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_construction_equipment_request_list" model="ir.ui.view">
        <field name="name">construction.equipment.request.list</field>
        <field name="model">construction.equipment.request</field>
        <field name="arch" type="xml">
            <list string="Equipment Requests">
                <field name="name"/>
                <field name="project_id"/>
                <field name="description"/>
                <field name="boq_item_id" optional="show"/>
                <field name="requested_quantity" optional="show"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="equipment_id" optional="show"/>
                <field name="rental_vendor_id" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="consumed_quantity" optional="show"/>
                <field name="planned_cost" optional="hide"/>
                <field name="actual_cost" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'submitted'" decoration-warning="state == 'to_approve'" decoration-success="state in ('assigned', 'rental')"/>
            </list>
        </field>
    </record>
    <record id="view_construction_equipment_request_search" model="ir.ui.view">
        <field name="name">construction.equipment.request.search</field>
        <field name="model">construction.equipment.request</field>
        <field name="arch" type="xml">
            <search string="Search Equipment Requests">
                <field name="name"/>
                <field name="project_id"/>
                <field name="equipment_id"/>
                <filter string="To Process" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Assigned" name="assigned" domain="[('state', '=', 'assigned')]"/>
                <filter string="Rented" name="rental" domain="[('state', '=', 'rental')]"/>
                <group>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_construction_equipment_request" model="ir.actions.act_window">
        <field name="name">Equipment Requests</field>
        <field name="res_model">construction.equipment.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
