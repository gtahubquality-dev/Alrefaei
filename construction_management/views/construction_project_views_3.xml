<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_project_form_cost_report" model="ir.ui.view">
        <field name="name">construction.project.form.cost.report</field>
        <field name="model">construction.project</field>
        <field name="inherit_id" ref="construction_management.view_construction_project_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_cost_revenue_report" type="object" class="oe_stat_button" icon="fa-line-chart" groups="construction_management.group_construction_manager,construction_management.group_construction_finance">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Cost &amp; Revenue</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
