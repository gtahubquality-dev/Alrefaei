<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_change_order_line_form" model="ir.ui.view">
        <field name="name">construction.change.order.line.form</field>
        <field name="model">construction.change.order.line</field>
        <field name="arch" type="xml">
            <form string="Change Line">
                <sheet>
                    <field name="project_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="change_type" widget="radio"/>
                            <field name="boq_item_id" invisible="change_type != 'quantity'" required="change_type == 'quantity'"/>
                            <field name="current_quantity" invisible="change_type != 'quantity'"/>
                            <field name="code" invisible="change_type != 'new'"/>
                            <field name="name" required="change_type == 'new'"/>
                            <field name="uom_id" invisible="change_type != 'new'" required="change_type == 'new'"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="unit_price" invisible="change_type != 'new'"/>
                            <field name="value_change"/>
                            <field name="previous_quantity" invisible="not previous_quantity"/>
                            <field name="new_boq_item_id" invisible="not new_boq_item_id"/>
                        </group>
                    </group>
                    <field name="description" invisible="change_type != 'new'" placeholder="Contractual description of the new item..."/>
                    <separator string="Cost Components of the New Item" invisible="change_type != 'new'"/>
                    <field name="component_ids" invisible="change_type != 'new'">
                        <list editable="bottom">
                            <field name="component_type"/>
                            <field name="product_id" required="component_type == 'material'"/>
                            <field name="name"/>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="unit_cost"/>
                            <field name="total_cost" sum="Total"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
