<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_deduction_type_list" model="ir.ui.view">
        <field name="name">construction.deduction.type.list</field>
        <field name="model">construction.deduction.type</field>
        <field name="arch" type="xml">
            <list string="Deduction Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="applies_to"/>
                <field name="kind"/>
                <field name="calculation"/>
                <field name="value"/>
                <field name="frequency"/>
                <field name="account_id"/>
                <field name="refundable"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_construction_deduction_type" model="ir.actions.act_window">
        <field name="name">Deduction Types</field>
        <field name="res_model">construction.deduction.type</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
