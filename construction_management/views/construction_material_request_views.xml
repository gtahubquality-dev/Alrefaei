<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_material_request_form" model="ir.ui.view">
        <field name="name">construction.material.request.form</field>
        <field name="model">construction.material.request</field>
        <field name="arch" type="xml">
            <form string="Material Request">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve Exceeding Quantities" class="btn-primary" invisible="state != 'to_approve'" groups="construction_management.group_construction_manager"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'to_approve'" groups="construction_management.group_construction_manager"/>
                    <button name="action_process" type="object" string="Create Transfer" class="btn-primary" invisible="state != 'approved' or request_type != 'transfer'" groups="stock.group_stock_user,construction_management.group_construction_manager"/>
                    <button name="action_process" type="object" string="Create Purchase Order" class="btn-primary" invisible="state != 'approved' or request_type != 'purchase'" groups="purchase.group_purchase_user,construction_management.group_construction_manager"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_document" type="object" class="oe_stat_button" icon="fa-exchange" string="Transfer" invisible="not picking_id"/>
                        <button name="action_view_document" type="object" class="oe_stat_button" icon="fa-shopping-cart" string="Purchase Order" invisible="not purchase_order_id"/>
                    </div>
                    <div class="alert alert-warning mb-2" role="alert" invisible="not exceeds_boq">
                        Requested quantities exceed the remaining approved BOQ quantities.
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="warehouse_id"/>
                            <field name="request_type" widget="radio" readonly="state not in ('draft', 'approved')"/>
                            <field name="source_warehouse_id" invisible="request_type != 'transfer'" required="request_type == 'transfer' and state == 'approved'" readonly="state in ('done', 'cancelled')"/>
                            <field name="vendor_id" invisible="request_type != 'purchase'" required="request_type == 'purchase' and state == 'approved'" readonly="state in ('done', 'cancelled')"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="date_required" readonly="state != 'draft'"/>
                            <field name="requested_by_id"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                            <field name="approved_date" invisible="not approved_date"/>
                            <field name="exceeds_boq" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Materials" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" decoration-danger="exceeds_boq">
                                    <field name="project_id" column_invisible="True"/>
                                    <field name="requirement_id" options="{'no_create': True}"/>
                                    <field name="product_id" column_invisible="True"/>
                                    <field name="boq_component_id" options="{'no_create': True}" optional="show"/>
                                    <field name="uom_id"/>
                                    <field name="boq_quantity"/>
                                    <field name="remaining_quantity"/>
                                    <field name="available_quantity"/>
                                    <field name="quantity"/>
                                    <field name="exceeds_boq"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="purchased_quantity" optional="show" column_invisible="parent.request_type != 'purchase' or parent.state != 'done'"/>
                                    <field name="received_quantity" optional="show" column_invisible="parent.state != 'done'" decoration-success="received_quantity &gt;= quantity" decoration-warning="received_quantity &lt; quantity"/>
                                    <field name="billed_quantity" optional="show" column_invisible="parent.request_type != 'purchase' or parent.state != 'done'"/>
                                    <field name="actual_cost" optional="show" column_invisible="parent.state != 'done'" sum="Actual Cost"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                    <group invisible="not picking_id and not purchase_order_id">
                        <field name="picking_id" invisible="not picking_id"/>
                        <field name="purchase_order_id" invisible="not purchase_order_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
