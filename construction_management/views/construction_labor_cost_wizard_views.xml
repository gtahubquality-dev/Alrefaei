<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_labor_cost_wizard_form" model="ir.ui.view">
        <field name="name">construction.labor.cost.wizard.form</field>
        <field name="model">construction.labor.cost.wizard</field>
        <field name="arch" type="xml">
            <form string="Allocate Labor Cost">
                <group>
                    <group>
                        <field name="project_id" readonly="context.get('default_project_id')"/>
                        <field name="company_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0">
                        <field name="assignment_id" readonly="1" force_save="1"/>
                        <field name="date_from" readonly="1" force_save="1"/>
                        <field name="date_to" readonly="1" force_save="1"/>
                        <field name="days" readonly="1" force_save="1"/>
                        <field name="currency_id" column_invisible="True"/>
                        <field name="amount" sum="Total"/>
                    </list>
                </field>
                <group class="oe_subtotal_footer">
                    <field name="amount_total"/>
                </group>
                <footer>
                    <button name="action_allocate" type="object" string="Post to Project Cost Center" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
