<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_project_cost_report_form" model="ir.ui.view">
        <field name="name">construction.project.cost.report.form</field>
        <field name="model">construction.project.cost.report</field>
        <field name="arch" type="xml">
            <form string="Project Cost &amp; Revenue" create="0" delete="0">
                <header>
                    <button name="action_print" type="object" string="Print" icon="fa-print" class="btn-primary" invisible="not project_id"/>
                </header>
                <div class="o_form_sheet p-3">
                    <group>
                        <group>
                            <field name="project_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <field name="report_html" readonly="1" nolabel="1"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_construction_project_cost_report" model="ir.actions.act_window">
        <field name="name">Project Cost &amp; Revenue</field>
        <field name="res_model">construction.project.cost.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_construction_project_cost_report_form"/>
        <field name="target">current</field>
    </record>
</odoo>
