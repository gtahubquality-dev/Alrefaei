<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_equipment_expense_form" model="ir.ui.view">
        <field name="name">construction.equipment.expense.form</field>
        <field name="model">construction.equipment.expense</field>
        <field name="arch" type="xml">
            <form string="Equipment Expense">
                <header>
                    <button name="action_submit" type="object" string="Submit to Accountant" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_create_bill" type="object" string="Record Vendor Bill" class="btn-primary" invisible="state != 'submitted'" groups="construction_management.group_construction_finance"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('billed', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,billed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bill" type="object" class="oe_stat_button" icon="fa-pencil-square-o" string="Vendor Bill" invisible="not move_id"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="equipment_id" readonly="state != 'draft'"/>
                            <field name="project_id" readonly="1" force_save="1"/>
                            <field name="request_id" invisible="not project_id" readonly="state == 'billed'" options="{'no_create': True}"/>
                            <field name="expense_type" readonly="state != 'draft'"/>
                            <field name="description" readonly="state not in ('draft', 'submitted')"/>
                        </group>
                        <group>
                            <field name="expense_datetime" readonly="state not in ('draft', 'submitted')"/>
                            <field name="vendor_id" readonly="state not in ('draft', 'submitted')"/>
                            <field name="vendor_reference" readonly="state not in ('draft', 'submitted')"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="submitted_by_id" invisible="not submitted_by_id"/>
                            <field name="move_id" invisible="not move_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_construction_equipment_expense_list" model="ir.ui.view">
        <field name="name">construction.equipment.expense.list</field>
        <field name="model">construction.equipment.expense</field>
        <field name="arch" type="xml">
            <list string="Equipment Expenses">
                <field name="date"/>
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="expense_type"/>
                <field name="project_id"/>
                <field name="request_id" optional="hide"/>
                <field name="vendor_id" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'billed'" decoration-warning="state == 'submitted'"/>
            </list>
        </field>
    </record>
    <record id="view_construction_equipment_expense_search" model="ir.ui.view">
        <field name="name">construction.equipment.expense.search</field>
        <field name="model">construction.equipment.expense</field>
        <field name="arch" type="xml">
            <search string="Search Equipment Expenses">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="project_id"/>
                <field name="vendor_id"/>
                <filter string="To Record" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Recorded" name="billed" domain="[('state', '=', 'billed')]"/>
                <separator/>
                <filter string="Maintenance &amp; Repair" name="maintenance" domain="[('expense_type', 'in', ('maintenance', 'repair'))]"/>
                <filter string="Rental" name="rental" domain="[('expense_type', '=', 'rental')]"/>
                <group>
                    <filter string="Equipment" name="group_equipment" context="{'group_by': 'equipment_id'}"/>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Expense Type" name="group_type" context="{'group_by': 'expense_type'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_construction_equipment_expense_pivot" model="ir.ui.view">
        <field name="name">construction.equipment.expense.pivot</field>
        <field name="model">construction.equipment.expense</field>
        <field name="arch" type="xml">
            <pivot string="Equipment Expenses">
                <field name="equipment_id" type="row"/>
                <field name="expense_type" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_construction_equipment_expense" model="ir.actions.act_window">
        <field name="name">Equipment Expenses</field>
        <field name="res_model">construction.equipment.expense</field>
        <field name="view_mode">list,form,pivot</field>
    </record>
</odoo>
