<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_equipment_form_inherit" model="ir.ui.view">
        <field name="name">construction.equipment.form.equipment</field>
        <field name="model">construction.equipment</field>
        <field name="inherit_id" ref="construction_management.view_construction_equipment_form"/>
        <field name="arch" type="xml">
            <field name="location_note" position="after">
                <field name="track_in_inventory" readonly="product_id"/>
                <field name="product_id" invisible="not product_id"/>
                <field name="stock_location_id" invisible="not product_id"/>
            </field>
            <xpath expr="//field[@name='hourly_rate']/.." position="after">
                <group string="Utilization &amp; Costs">
                    <field name="total_hours"/>
                    <field name="total_usage_cost"/>
                    <field name="total_maintenance_cost"/>
                    <field name="total_rental_cost"/>
                    <field name="total_other_cost"/>
                </group>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Movements" name="movements">
                        <field name="movement_ids" readonly="1">
                            <list>
                                <field name="date"/>
                                <field name="name"/>
                                <field name="from_project_id"/>
                                <field name="to_project_id"/>
                                <field name="currency_id" column_invisible="True"/>
                                <field name="transport_cost"/>
                                <field name="state" widget="badge"/>
                            </list>
                        </field>
                    </page>
                    <page string="Usage Logs" name="usage">
                        <field name="usage_ids" readonly="1">
                            <list>
                                <field name="date"/>
                                <field name="project_id"/>
                                <field name="hours" sum="Hours"/>
                                <field name="diesel_liters" sum="Diesel"/>
                                <field name="currency_id" column_invisible="True"/>
                                <field name="total_cost" sum="Cost"/>
                                <field name="state" widget="badge"/>
                            </list>
                        </field>
                    </page>
                    <page string="Expenses" name="expenses">
                        <field name="expense_ids" readonly="1">
                            <list>
                                <field name="date"/>
                                <field name="name"/>
                                <field name="expense_type"/>
                                <field name="project_id"/>
                                <field name="vendor_id"/>
                                <field name="currency_id" column_invisible="True"/>
                                <field name="amount" sum="Total"/>
                                <field name="state" widget="badge"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
    <record id="action_equipment_machines" model="ir.actions.act_window">
        <field name="name">Machines &amp; Equipment</field>
        <field name="res_model">construction.equipment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_vehicle', '=', False)]</field>
        <field name="context">{'default_category': 'equipment'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register the machines and equipment</p>
            <p>Equipment, mixers, generators... owned by the company or rented, moved between the main yard and the
                project sites. Vehicles are managed in the Fleet application.</p>
        </field>
    </record>
</odoo>
